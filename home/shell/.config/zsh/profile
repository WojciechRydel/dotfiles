# vim:filetype=zsh

# PATH intentionally lives in .zshenv, not here: this file is only sourced for
# login/interactive shells, so assigning PATH here gave `zsh -c ...` a
# different command precedence than the prompt.

source $ZDOTDIR/aliases

if [[ -d $ZDOTDIR/local ]]; then
  for f in $ZDOTDIR/local/*; do source "${f}"; done
fi
