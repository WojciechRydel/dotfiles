#!/bin/sh
# notif-log -- append one live mako notification to the persistent history.
#
# Invoked by mako via `on-notify=exec "$HOME/.local/bin/notif-log" "$id"`.
# mako only hands us the notification id, so the payload is read back out of
# `makoctl list -j`. Kept deliberately cheap: this runs on every notification.
set -eu

id="${1:-}"
[ -n "$id" ] || exit 0

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mako"
LOG="$STATE_DIR/history.jsonl"
LOCK="$STATE_DIR/history.lock"

mkdir -p "$STATE_DIR"

entry=$(makoctl list -j 2>/dev/null | jq -c --argjson id "$id" '
	map(select(.id == $id)) | .[0] // empty
	| {
		ts: (now | floor),
		id: .id,
		app: (.app_name // ""),
		summary: (.summary // ""),
		body: (.body // ""),
		urgency: (.urgency // "normal"),
		category: .category,
		desktop_entry: .desktop_entry,
		icon: (.app_icon // "")
	}') || exit 0

[ -n "$entry" ] || exit 0

exec 9>"$LOCK"
flock 9
printf '%s\n' "$entry" >>"$LOG"
exec 9>&-

# Nudge the waybar indicator (custom/notifications listens on signal 8).
pkill -RTMIN+8 waybar 2>/dev/null || true
