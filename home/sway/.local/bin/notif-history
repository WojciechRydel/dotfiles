#!/bin/sh
# notif-history -- persistent, TTL-pruned history for mako notifications.
#
#   notif-history                pick an entry with bemenu, copy its text
#   notif-history --list         print the history as plain text (newest first)
#   notif-history --json         print the pruned history as JSONL
#   notif-history --prune        drop entries past the TTL, then exit
#   notif-history --clear        delete the whole history
#   notif-history --count        print "<unseen> <total>"
#   notif-history --mark-seen    reset the unseen counter
#   notif-history --waybar       emit a waybar JSON status blob
#   notif-history --dnd-toggle   toggle mako's do-not-disturb mode
#
# Retention: entries older than TTL_DAYS are dropped, and at most MAX_ENTRIES
# rows are kept. Override either in $XDG_CONFIG_HOME/mako/history.env.
set -eu

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mako"
LOG="$STATE_DIR/history.jsonl"
LOCK="$STATE_DIR/history.lock"
SEEN="$STATE_DIR/history.seen"

TTL_DAYS=7
MAX_ENTRIES=2000
BEMENU_FONT="Ubuntu Mono 14"
BEMENU_LINES=20

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/mako/history.env"
if [ -r "$CONF" ]; then
	# shellcheck disable=SC1090
	. "$CONF"
fi

mkdir -p "$STATE_DIR"
[ -e "$LOG" ] || : >"$LOG"

# Turn JSONL on stdin into aligned, single-line display rows.
render() {
	jq -Rr '
		fromjson? // empty
		| (.ts // 0 | strflocaltime("%m-%d %H:%M")) as $t
		| ((.app // "?") + "            " | .[0:12]) as $a
		| ((.summary // "")
		   + (if ((.body // "") | length) > 0 then "  ·  " + .body else "" end)
		   | gsub("<[^>]*>"; "")
		   | gsub("[\\n\\r\\t]+"; " ")
		   | gsub(" {2,}"; " ")
		   | .[0:200]) as $m
		| "\($t)  \($a)  \($m)"
	'
}

prune() {
	cutoff=$(( $(date +%s) - TTL_DAYS * 86400 ))
	exec 9>"$LOCK"
	flock 9
	if jq -Rc --argjson cutoff "$cutoff" \
		'fromjson? // empty | select((.ts // 0) >= $cutoff)' \
		"$LOG" >"$LOG.raw"
	then
		tail -n "$MAX_ENTRIES" "$LOG.raw" >"$LOG.tmp"
		mv "$LOG.tmp" "$LOG"
	fi
	rm -f "$LOG.raw" "$LOG.tmp"
	exec 9>&-
}

# Valid entries, newest first, one JSON object per line.
entries() {
	jq -Rc 'fromjson? // empty' "$LOG" | tac
}

# JSONL on stdin -> Pango markup cards for the waybar tooltip, styled to match
# notif-panel. Text is stripped of any markup the sender embedded and then
# escaped, so a body containing "<b>" or "&" cannot break the tooltip.
render_markup() {
	jq -Rr '
		def clean($n):
			(. // "")
			| gsub("<[^>]*>"; "")
			| gsub("[\\n\\r\\t]+"; " ")
			| gsub(" {2,}"; " ")
			| .[0:$n]
			| @html;

		fromjson? // empty
		| (.ts // 0 | strflocaltime("%H:%M")) as $t
		| (.app | clean(24)) as $a
		| (.summary | clean(56)) as $s
		| (.body | clean(64)) as $b
		| (if .urgency == "critical" then "#eb4d4b"
		   elif .urgency == "low" then "#8b96a5"
		   else "#90b1b1" end) as $c
		| "<span color=\"\($c)\"><b>\($a)</b></span> <span color=\"#8b96a5\">\($t)</span>"
		  + (if $s == "" then "" else "\n\($s)" end)
		  + (if $b == "" then "" else "\n<span color=\"#8b96a5\">\($b)</span>" end)
		  + "\n"
	'
}

last_seen() {
	if [ -r "$SEEN" ]; then
		cat "$SEEN"
	else
		echo 0
	fi
}

mark_seen() {
	date +%s >"$SEEN"
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

dnd_active() {
	makoctl mode 2>/dev/null | grep -qx 'do-not-disturb'
}

pick() {
	prune
	tmpdir=$(mktemp -d)
	trap 'rm -rf "$tmpdir"' EXIT INT TERM

	entries >"$tmpdir/entries.jsonl"
	if [ ! -s "$tmpdir/entries.jsonl" ]; then
		notify-send -a notif-history -t 2000 "Notification history" "empty"
		return 0
	fi

	# render() emits exactly one row per input line, so lines and entries stay
	# index-aligned.
	render <"$tmpdir/entries.jsonl" >"$tmpdir/lines"

	sel=$(bemenu -i -l "$BEMENU_LINES" --scrollbar always --line-height 10 \
		--fn "$BEMENU_FONT" -p 'notif' <"$tmpdir/lines") || { mark_seen; return 0; }
	mark_seen
	[ -n "$sel" ] || return 0

	n=$(grep -nxF -m1 -e "$sel" "$tmpdir/lines" | cut -d: -f1) || return 0
	[ -n "$n" ] || return 0
	entry=$(head -n "$n" "$tmpdir/entries.jsonl" | tail -n 1)

	text=$(printf '%s' "$entry" | jq -r '
		if ((.body // "") | length) > 0 then .body else (.summary // "") end')
	[ -n "$text" ] || return 0

	printf '%s' "$text" | wl-copy
	notify-send -a notif-history -t 2000 "Copied to clipboard" \
		"$(printf '%s' "$text" | head -c 120)"
}

counts() {
	last=$(last_seen)
	unseen=$(jq -Rr --argjson last "$last" \
		'fromjson? // empty | select((.ts // 0) > $last) | 1' "$LOG" | wc -l)
	total=$(jq -Rr 'fromjson? // empty | 1' "$LOG" | wc -l)
	printf '%s %s\n' "$unseen" "$total"
}

waybar() {
	prune
	set -- $(counts)
	unseen=$1
	total=$2

	# Font Awesome glyphs, spelled as UTF-8 octal so the codepoints survive
	# any editor or transport that mangles the private use area:
	# \357\203\263 = U+F0F3 bell, \357\207\266 = U+F1F6 bell-slash.
	if dnd_active; then
		icon=$(printf '\357\207\266')
		class=dnd
	elif [ "$unseen" -gt 0 ]; then
		icon=$(printf '\357\203\263')
		class=unread
	else
		icon=$(printf '\357\203\263')
		class=idle
	fi

	if [ "$unseen" -gt 0 ]; then
		text="$icon $unseen"
	else
		text="$icon"
	fi

	preview=5
	head="<b>$unseen unseen</b> <span color=\"#8b96a5\">· $total kept · TTL ${TTL_DAYS}d</span>"
	if [ "$class" = dnd ]; then
		head="<span color=\"#d35400\"><b>do not disturb</b></span>  $head"
	fi
	recent=$(entries | head -n "$preview" | render_markup)
	more=""
	if [ "$total" -gt "$preview" ]; then
		more="<span color=\"#8b96a5\">… and $((total - preview)) more · click to open</span>"
	fi

	jq -nc --arg text "$text" --arg class "$class" --arg head "$head" \
		--arg recent "$recent" --arg more "$more" '
		{
			text: $text,
			class: $class,
			alt: $class,
			tooltip: ([$head, ($recent | rtrimstr("\n")), $more]
			          | map(select(. != "")) | join("\n\n"))
		}'
}

case "${1:---pick}" in
	--pick|pick|"")
		pick
		;;
	--list|-l)
		prune
		entries | render
		;;
	--json)
		prune
		entries
		;;
	--prune)
		prune
		;;
	--clear)
		exec 9>"$LOCK"
		flock 9
		: >"$LOG"
		exec 9>&-
		mark_seen
		;;
	--count)
		counts
		;;
	--mark-seen)
		mark_seen
		;;
	--waybar)
		waybar
		;;
	--dnd-toggle)
		makoctl mode -t do-not-disturb >/dev/null
		if dnd_active; then
			notify-send -a notif-history -u critical -t 2000 \
				"Do not disturb" "on"
		else
			notify-send -a notif-history -t 2000 "Do not disturb" "off"
		fi
		pkill -RTMIN+8 waybar 2>/dev/null || true
		;;
	-h|--help)
		# The header block only: stop at the first non-comment line.
		awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
		;;
	*)
		printf 'notif-history: unknown option: %s\n' "$1" >&2
		exit 2
		;;
esac
