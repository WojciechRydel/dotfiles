# vim: filetype=neomuttrc
unmailboxes *

set realname = "Wojciech Rydel"
set from = "wojciech@rydel.com.pl"
set sendmail = "~/.local/bin/msmtpq -a voytech"

set folder = "~/.mail/wojciech@rydel.com.pl/"
set mbox_type = Maildir
set spoolfile = "+INBOX"
set postponed = "+Drafts"
set trash = "+Trash"
set record = "+Outbox"
set my_archive = "Archives"
mailboxes =INBOX =Outbox ="Sent" =Archives =Drafts =Trash

