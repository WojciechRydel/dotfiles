# vim: filetype=neomuttrc
unmailboxes *

set realname = "Wojciech Rydel"
set from = "rydel.wojciech@gmail.com"
set sendmail = "~/.local/bin/msmtpq -a gmail-private"

set folder = "~/.mail/rydel.wojciech@gmail.com/"
set mbox_type = Maildir
set spoolfile = "+INBOX"
set postponed = "+Drafts"
set trash = "+Trash"
set record = "+Outbox"
set my_archive = "Archives"

mailboxes =INBOX =Outbox ="Sent" =Drafts =Trash =Archives

