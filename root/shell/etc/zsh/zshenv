# /etc/zsh/zshenv: system-wide .zshenv file for zsh(1).
#
# This file is sourced on all invocations of the shell.
# If the -f flag is present or if the NO_RCS option is
# set within this file, all other initialization files
# are skipped.
#
# This file should contain commands to set the command
# search path, plus other important environment variables.
# This file should not contain commands that produce
# output or assume the shell is attached to a tty.
#
# Global Order: zshenv, zprofile, zshrc, zlogin

if [[ -z "$PATH" || "$PATH" == "/bin:/usr/bin" ]]
then
	export PATH="/usr/local/bin:/usr/bin:/bin:/usr/games"
fi

# oh-my-zsh
export ZSH=/usr/share/oh-my-zsh

# ZDOTDIR must be set here, in zshenv, so that $ZDOTDIR/.zshenv is found by
# every shell type -- that is where PATH is settled.
#
# It cannot be derived from a bare ${XDG_CONFIG_HOME}: that variable is exported
# by /etc/profile.d/xdg-dirs.sh, which /etc/profile sources, which only runs
# later (from /etc/zsh/zprofile, login shells only). A shell that does not
# already have XDG_CONFIG_HOME in its environment -- tty login, ssh, a systemd
# user unit, anything started by a display manager -- would otherwise get
# ZDOTDIR=/zsh and silently load none of the user's zsh config at all.
# Default it here instead, with the same value xdg-dirs.sh uses.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR="${XDG_CONFIG_HOME}/zsh"
