*.kml
home/gnupg/.gnupg
home/default-apps/
home/gnupg/.gnupg/sshcontrol

# --- secrets and host-local identity: never commit ---
# This repo is PUBLIC on GitHub, so anything committed here is world-readable
# the moment it is pushed. These patterns are a guard against `git add -A`.
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
# Per-client git identity includes, generated by `work-context`. They contain
# real names, personal/work emails and client names. Host-local by design --
# if you ever want one tracked, add a `!` negation for that single file.
home/git/.config/git/*.inc
